{
  "expo": {
    "name": "Geração Solar",
    "slug": "geracao-mobile",
    "scheme": "geracao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7D6",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E141B"
          }
        }
      ],
      "expo-document-picker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.geracao.mobile"
    },
    "android": {
      "package": "br.com.geracao.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F59E0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://geracao.igfinanca.com",
      "eas": {
        "projectId": "acaa61d5-b7b6-4b2b-ab1c-dbe69964e62b"
      }
    },
    "owner": "mirahy"
  }
}
